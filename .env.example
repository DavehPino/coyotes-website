# Copia este archivo a `.env.local` (desarrollo) y carga las mismas variables en
# Vercel → Project → Settings → Environment Variables.
# Solo las variables con prefijo VITE_ llegan al navegador. El resto son SOLO servidor.

# ─── Supabase (Project Settings → API Keys) ──────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave secreta (sb_secret_...) o service_role. Ignora RLS: NUNCA exponer al cliente.
SUPABASE_SECRET_KEY=

# ─── Bucket de videos (API compatible con S3) ────────────────────────────────
# Cloudflare R2: copia el "S3 API" de Bucket → Settings (sin el /<bucket> final). Depende de la
# jurisdicción: https://<ACCOUNT_ID>[.us|.eu].r2.cloudflarestorage.com  | AWS S3: dejar vacío
S3_ENDPOINT=
# R2: auto | AWS: p.ej. us-east-1
S3_REGION=auto
S3_BUCKET=coyotes-videos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Carpeta dentro del bucket donde viven los videos (vacío = todo el bucket)
S3_VIDEO_PREFIX=
# Opcional: URL pública del bucket (dominio propio o r2.dev). Si está vacía,
# el backend genera URLs firmadas temporales para reproducir.
STORAGE_PUBLIC_BASE_URL=
# Duración de las URLs firmadas en segundos
SIGNED_URL_TTL_SECONDS=3600

# ─── Vercel Cron ─────────────────────────────────────────────────────────────
# Vercel lo envía como `Authorization: Bearer <CRON_SECRET>` al llamar al cron.
CRON_SECRET=

# ─── Web pública ─────────────────────────────────────────────────────────────
# Home: "landing" (por defecto: escudo, nombre y eslogan) o "full" (página completa con
# Sobre el equipo, Entrenamientos y Contacto). Se fija al hacer build.
# VITE_HOME_VARIANT=landing
# URL absoluta del sitio para las etiquetas Open Graph (og:image / og:url). Si está vacía,
# en Vercel se usa VERCEL_PROJECT_PRODUCTION_URL; en local quedan rutas relativas.
# VITE_SITE_URL=https://tudominio.com

# ─── Solo desarrollo ─────────────────────────────────────────────────────────
# Reenvía /api desde `npm run dev` a otro servidor (p.ej. `vercel dev` en el puerto 3000).
# API_PROXY=http://localhost:3000
